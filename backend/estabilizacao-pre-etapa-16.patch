+ * pedido aberto: não existe dono/atendente responsável por um pedido neste
+ * sistema (instalação única de padaria, sem garçom/mesa/comanda).
+ *
+ * Busca opcional por nome (substring, sem diferenciar maiúsculas/
+ * minúsculas) ou número operacional exato (aceita "27"/"#27") — mesmo
+ * formato de busca usado em Caixa/Retirada/Histórico, reimplementado aqui
+ * porque cada módulo é independente.
+ *
+ * Ordenado por createdAt asc (mais antigos primeiro — quem está esperando
+ * há mais tempo aparece primeiro), com id asc como desempate determinístico.
+ * totalCents é sempre recalculado no backend, somando só os itens não
+ * CANCELADO — nunca confiado do cliente.
+ */
+export async function listOpenOrders(search?: string): Promise<OpenOrderSummary[]> {
+  const where: Prisma.OrderWhereInput = {
+    paymentStatus: "PENDENTE",
+    cancelledAt: null,
+    deliveredAt: null,
+  };
+
+  const trimmedSearch = search?.trim();
+  if (trimmedSearch) {
+    // Aceita "27" e "#27" como o mesmo número operacional — só o # inicial
+    // é removido, então "#" sozinho ou "2#7" seguem como busca por nome.
+    // Uma busca numérica nunca é tratada como substring de nome.
+    const withoutLeadingHash = trimmedSearch.startsWith("#")
+      ? trimmedSearch.slice(1)
+      : trimmedSearch;
+    const asServiceNumber = Number(withoutLeadingHash);
+    const matchesServiceNumber =
+      withoutLeadingHash !== "" && Number.isInteger(asServiceNumber) && asServiceNumber > 0;
+
+    where.OR = [
+      { customerName: { contains: trimmedSearch, mode: "insensitive" } },
+      ...(matchesServiceNumber ? [{ serviceNumber: asServiceNumber }] : []),
+    ];
+  }

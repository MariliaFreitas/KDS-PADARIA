diff --git a/backend/src/modules/orders/__tests__/payment-delivery-race.test.ts b/backend/src/modules/orders/__tests__/payment-delivery-race.test.ts
new file mode 100644
index 0000000..13dadb4
--- /dev/null
+++ b/backend/src/modules/orders/__tests__/payment-delivery-race.test.ts
@@ -0,0 +1,293 @@
+import { describe, it, expect, vi } from "vitest";
+
+/**
+ * Estabilização pré-Etapa 16, item 7: corrida entre confirmPayment
+ * (módulo cashier) e deliverItem (módulo delivery) no MESMO pedido —
+ * cenário crítico porque as duas operações vivem em módulos diferentes,
+ * mas precisam terminar num estado final consistente independentemente de
+ * qual delas "vence".
+ *
+ * Estado inicial em todos os testes: pedido LOCAL, paymentStatus=PENDENTE,
+ * Order.deliveredAt=null, último item válido ainda não entregue.
+ *
+ * Cobre as duas ordens lógicas de forma DETERMINÍSTICA (chamando uma
+ * operação até o fim, depois a outra — sem depender de nenhum agendamento
+ * de Promise.all) e, adicionalmente, um teste de corrida real entre as
+ * duas funções de verdade (não simulada por sequenciamento explícito),
+ * usando o mesmo mecanismo de fake DB com mutex por orderId (reproduzindo
+ * SELECT ... FOR UPDATE) já usado em cashier-concurrent-payment.test.ts e
+ * delivery-concurrent-delivery.test.ts — como as duas travam a mesma linha
+ * do pedido como primeira coisa que fazem, a ordem em que cada uma é
+ * disparada (a primeira do array, que roda de forma síncrona até a
+ * primeira espera real) decide deterministicamente quem trava primeiro.
+ *
+ * Resultado final exigido, em TODOS os casos: paymentStatus=PAGO, paidAt
+ * preenchido, item entregue, Order.deliveredAt preenchido, exatamente 1
+ * PAYMENT_CONFIRMED, exatamente 1 ITEM_DELIVERED, exatamente 1
+ * ORDER_DELIVERED, serviceNumber agendado corretamente, nenhum metadado
+ * sobrescrito por chamada duplicada.
+ */
+
+interface FakeOrderRow {
+  id: string;
+  paymentStatus: "PENDENTE" | "PAGO";
+  paidAt: Date | null;
+  paidByUserId: string | null;
+  cancelledAt: Date | null;
+  consumptionType: "LOCAL" | "VIAGEM";
+  deliveredAt: Date | null;
+}
+
+interface FakeItemRow {
+  id: string;
+  orderId: string;
+  totalCents: number;
+  status: "PENDENTE" | "CANCELADO";
+  requiresProductionSnapshot: boolean;
+  deliveredAt: Date | null;
+}
+
+function createSharedFakeDb() {
+  const orders = new Map<string, FakeOrderRow>();
+  const items = new Map<string, FakeItemRow>();
+  const historyEntries: Array<{
+    orderId: string;
+    orderItemId: string | null;
+    action: string;
+    previousState?: string | null;
+    newState?: string | null;
+    userId: string;
+  }> = [];
+  const reuseScheduledCalls: Array<{ orderId: string; reusableAt: Date }> = [];
+  const lockQueues = new Map<string, Promise<void>>();
+
+  async function acquireOrderLock(orderId: string, registerRelease: (release: () => void) => void) {
+    const previousTail = lockQueues.get(orderId) ?? Promise.resolve();
+    let release!: () => void;
+    const myTurn = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    lockQueues.set(
+      orderId,
+      previousTail.then(() => myTurn),
+    );
+    await previousTail;
+    registerRelease(release);
+  }
+
+  function makeTx(locksHeld: Array<() => void>) {
+    return {
+      async $queryRaw(_strings: TemplateStringsArray, orderId: string) {
+        await acquireOrderLock(orderId, (release) => locksHeld.push(release));
+        return [{ id: orderId }];
+      },
+      order: {
+        async findUnique({ where: { id } }: { where: { id: string } }) {
+          const order = orders.get(id);
+          if (!order) return null;
+          return { ...order, items: [...items.values()].filter((item) => item.orderId === id) };
+        },
+        async updateMany({
+          where,
+          data,
+        }: {
+          where: { id: string; paymentStatus?: string; cancelledAt?: null; deliveredAt?: null };
+          data: Partial<FakeOrderRow>;
+        }) {
+          const order = orders.get(where.id);
+          if (!order) return { count: 0 };
+
+          if (where.paymentStatus !== undefined) {
+            if (order.paymentStatus !== where.paymentStatus || order.cancelledAt !== null) {
+              return { count: 0 };
+            }
+            Object.assign(order, data);
+            return { count: 1 };
+          }
+
+          // Reivindicação de fechamento: where.deliveredAt === null.
+          if (order.deliveredAt !== null) return { count: 0 };
+          Object.assign(order, data);
+          return { count: 1 };
+        },
+      },
+      orderItem: {
+        async updateMany({
+          where,
+          data,
+        }: {
+          where: { id: string; deliveredAt: null };
+          data: Partial<FakeItemRow>;
+        }) {
+          const item = items.get(where.id);
+          if (!item || item.deliveredAt !== null) return { count: 0 };
+          Object.assign(item, data);
+          return { count: 1 };
+        },
+        async findUnique({ where: { id } }: { where: { id: string } }) {
+          const item = items.get(id);
+          return item ? { ...item } : null;
+        },
+      },
+      orderHistory: {
+        async create({ data }: { data: (typeof historyEntries)[number] }) {
+          historyEntries.push(data);
+          return { id: `history-${historyEntries.length}`, ...data };
+        },
+      },
+      serviceNumberSlot: {
+        async update({
+          where,
+          data,
+        }: {
+          where: { orderId: string };
+          data: { reusableAt: Date };
+        }) {
+          reuseScheduledCalls.push({ orderId: where.orderId, reusableAt: data.reusableAt });
+          return { id: "slot-1", number: 5, orderId: where.orderId, reusableAt: data.reusableAt };
+        },
+      },
+    };
+  }
+
+  const prisma = {
+    async $transaction<T>(callback: (tx: ReturnType<typeof makeTx>) => Promise<T>): Promise<T> {
+      const locksHeld: Array<() => void> = [];
+      try {
+        const tx = makeTx(locksHeld);
+        return await callback(tx);
+      } finally {
+        locksHeld.forEach((release) => release());
+      }
+    },
+  };
+
+  function seedOrder(row: FakeOrderRow) {
+    orders.set(row.id, row);
+  }
+
+  function seedItem(row: FakeItemRow) {
+    items.set(row.id, row);
+  }
+
+  return { prisma, orders, items, historyEntries, reuseScheduledCalls, seedOrder, seedItem };
+}
+
+const fakeDbHolder: { current: ReturnType<typeof createSharedFakeDb> | null } = { current: null };
+
+function currentDb(): ReturnType<typeof createSharedFakeDb> {
+  if (!fakeDbHolder.current) {
+    throw new Error("fake db não inicializado — chame resetFakeDb() antes do teste");
+  }
+  return fakeDbHolder.current;
+}
+
+vi.mock("../../../lib/prisma.js", () => ({
+  prisma: {
+    $transaction: (callback: (tx: unknown) => Promise<unknown>) =>
+      currentDb().prisma.$transaction(callback),
+  },
+}));
+
+function resetFakeDb() {
+  const db = createSharedFakeDb();
+  fakeDbHolder.current = db;
+  return db;
+}
+
+function seedInitialState(db: ReturnType<typeof createSharedFakeDb>) {
+  db.seedOrder({
+    id: "order-1",
+    paymentStatus: "PENDENTE",
+    paidAt: null,
+    paidByUserId: null,
+    cancelledAt: null,
+    consumptionType: "LOCAL",
+    deliveredAt: null,
+  });
+  db.seedItem({
+    id: "item-1",
+    orderId: "order-1",
+    totalCents: 1000,
+    status: "PENDENTE",
+    requiresProductionSnapshot: false,
+    deliveredAt: null,
+  });
+}
+
+function assertConsistentFinalState(db: ReturnType<typeof createSharedFakeDb>) {
+  const finalOrder = db.orders.get("order-1");
+  expect(finalOrder?.paymentStatus).toBe("PAGO");
+  expect(finalOrder?.paidAt).not.toBeNull();
+  expect(finalOrder?.deliveredAt).not.toBeNull();
+  expect(db.items.get("item-1")?.deliveredAt).not.toBeNull();
+
+  const byAction = (action: string) => db.historyEntries.filter((entry) => entry.action === action);
+  expect(byAction("PAYMENT_CONFIRMED")).toHaveLength(1);
+  expect(byAction("ITEM_DELIVERED")).toHaveLength(1);
+  expect(byAction("ORDER_DELIVERED")).toHaveLength(1);
+
+  expect(db.reuseScheduledCalls).toHaveLength(1);
+  expect(db.reuseScheduledCalls[0].orderId).toBe("order-1");
+}
+
+describe("corrida entre confirmPayment (cashier) e deliverItem (delivery) no mesmo pedido", () => {
+  it("ordem lógica A: entrega acontece primeiro, pagamento depois — confirmPayment fecha o pedido", async () => {
+    const db = resetFakeDb();
+    seedInitialState(db);
+
+    const { deliverItem } = await import("../../delivery/delivery.service.js");
+    const { confirmPayment } = await import("../../cashier/cashier.service.js");
+
+    await deliverItem("order-1", "item-1", "atendente-1");
+    // Item entregue, mas pagamento ainda pendente: pedido continua aberto.
+    expect(db.orders.get("order-1")?.deliveredAt).toBeNull();
+    expect(db.historyEntries.filter((entry) => entry.action === "ORDER_DELIVERED")).toHaveLength(0);
+
+    await confirmPayment("order-1", "caixa-1");
+
+    assertConsistentFinalState(db);
+  });
+
+  it("ordem lógica B: pagamento acontece primeiro, entrega depois — deliverItem fecha o pedido", async () => {
+    const db = resetFakeDb();
+    seedInitialState(db);
+
+    const { deliverItem } = await import("../../delivery/delivery.service.js");
+    const { confirmPayment } = await import("../../cashier/cashier.service.js");
+
+    await confirmPayment("order-1", "caixa-1");
+    // Pagamento confirmado, mas item ainda não entregue: pedido continua aberto.
+    expect(db.orders.get("order-1")?.deliveredAt).toBeNull();
+    expect(db.historyEntries.filter((entry) => entry.action === "ORDER_DELIVERED")).toHaveLength(0);
+
+    await deliverItem("order-1", "item-1", "atendente-1");
+
+    assertConsistentFinalState(db);
+  });
+
+  it("corrida real entre as duas funções (mesma trava de linha do pedido): estado final consistente e nenhum evento duplicado, qualquer que seja a ordem real de execução", async () => {
+    const db = resetFakeDb();
+    seedInitialState(db);
+
+    const { deliverItem } = await import("../../delivery/delivery.service.js");
+    const { confirmPayment } = await import("../../cashier/cashier.service.js");
+
+    // As duas chamadas são disparadas "ao mesmo tempo": cada uma roda
+    // sincronamente até a primeira espera real (a trava da linha do
+    // pedido, dentro de $queryRaw) antes da outra sequer começar — é a
+    // fila de trava (mutex por orderId), e não uma decisão explícita deste
+    // teste, que decide quem trava primeiro e portanto quem vence.
+    const results = await Promise.allSettled([
+      deliverItem("order-1", "item-1", "atendente-1"),
+      confirmPayment("order-1", "caixa-1"),
+    ]);
+
+    // As duas operações são legítimas nesse cenário (nenhuma delas
+    // colide com a outra do ponto de vista de negócio) — as duas devem
+    // ter sucesso, só a ORDEM em que fecham o pedido é que varia.
+    expect(results.every((result) => result.status === "fulfilled")).toBe(true);
+
+    assertConsistentFinalState(db);
+  });
+});

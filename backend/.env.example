# Copie este arquivo para .env e ajuste os valores.
# O .env nunca deve ser versionado — confira o .gitignore da raiz.

PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Banco de dados (Etapa 2). Precisa bater com o docker-compose.yml da raiz.
DATABASE_URL="postgresql://kds_padaria:kds_padaria@localhost:5432/kds_padaria?schema=public"

# Usado pelo seed — usuário administrador inicial.
# Troque a senha antes de rodar o seed em qualquer ambiente que não seja local.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# Autenticação (Etapa 3).
# Mínimo aceito: 16 caracteres. Recomendado: 32 ou mais.
# O valor abaixo é um placeholder e é RECUSADO pela aplicação — troque-o.
# Para gerar um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"
